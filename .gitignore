# Claude Code
# Se versiona la configuración compartida del proyecto; nunca la local ni el estado.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/skills

# Entorno y secretos
.env
.env.*
!.env.example

# Rango de refuerzo: transcripts y estado son spoilers del ataque a ciegas
reinforcement-range/transcript-*.json
reinforcement-range/state*.json

# Codex
# Solo se comparte la configuracion MCP del proyecto.
.codex/*
!.codex/config.toml

# Dependencias
node_modules/
.pnpm-store/

# Build y caché
dist/
build/
out/
.next/
.astro/
.turbo/
.cache/
*.tsbuildinfo

# Cobertura y reportes
coverage/
.lighthouseci/
evals/results/

# Python
__pycache__/
*.py[cod]
.venv/

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# El trinquete de la compuerta nocturna es estado local de la sesion.
noche/.piso-tests
