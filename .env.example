# Plantilla de variables. Copiar a .env y rellenar.
# Los valores reales nunca se versionan: en CI vienen de GitHub Secrets.

# Credenciales de un usuario IAM exclusivo y con permisos minimos.
HW_ACCESS_KEY=
HW_SECRET_KEY=
HW_REGION=

# Proveedor de inferencia Kostra.
MAAS_MODE=mock
MAAS_API_KEY=
MAAS_BASE_URL=https://ai.kostra.cloud/v1
MAAS_MODEL=glm-5.2
MAAS_TIMEOUT_SECONDS=45

# Almacen (PostgREST sobre HTTPS, ver ADR-0005).
# SUPABASE_URL debe ser https: la service_role ignora RLS y no puede viajar en claro.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
