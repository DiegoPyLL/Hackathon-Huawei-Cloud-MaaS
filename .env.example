# Credenciales de un usuario IAM exclusivo y con permisos minimos.
HW_ACCESS_KEY=
HW_SECRET_KEY=
HW_REGION=

# Proveedor de inferencia Kostra.
MAAS_MODE=mock
MAAS_API_KEY=
MAAS_BASE_URL=https://ai.kostra.cloud/v1
MAAS_MODEL=glm-5.2
MAAS_TIMEOUT_SECONDS=45

# Lectura de Pull Requests. Sin token solo funciona en repositorios publicos.
# Para publicar el veredicto hace falta permiso de escritura sobre issues:
# scope "repo" en un token clasico, o "Issues: Read and write" en uno fine-grained.
GITHUB_TOKEN=
